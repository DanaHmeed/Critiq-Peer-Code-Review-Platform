PORT=5000
NODE_ENV=development
# Hosted deployments: set this to the provider's PostgreSQL URL.
# When set, DATABASE_URL takes precedence over the local DB_* settings below.
# On Render, use the Internal Database URL for a database in the same region.
DATABASE_URL=
DB_HOST=localhost
DB_PORT=5432
DB_NAME=critiq_db
DB_USER=postgres
DB_PASSWORD=
# Generate locally; never commit the real value.
JWT_SECRET=
JWT_EXPIRES_IN=7d
CLIENT_URL=http://localhost:5173
API_PUBLIC_URL=http://localhost:5000
GITHUB_CLIENT_ID=
GITHUB_CLIENT_SECRET=
GITHUB_CALLBACK_URL=http://localhost:5000/api/auth/github/callback
# Password-reset delivery through Resend; EMAIL_FROM must use a verified domain.
RESEND_API_KEY=
EMAIL_FROM=Critiq <no-reply@example.com>
RESET_TOKEN_TTL_MINUTES=60
